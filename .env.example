# Supabase Configuration
# Obtener estas credenciales desde: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Solo servidor: escribe catálogos y caché. NUNCA con prefijo NEXT_PUBLIC_ ni en el navegador
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# API de estadísticas deportivas: API-Football (solo servidor)
# Plan gratuito verificado: 100 consultas/día, fechas solo de ayer a mañana, temporadas 2022-2024 por equipo
# Panel: https://dashboard.api-football.com/
API_FOOTBALL_KEY=your-api-football-key

# Configuración de la aplicación
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Lectura de tickets con Gemini (solo servidor, NUNCA con prefijo NEXT_PUBLIC_)
# Clave desde https://aistudio.google.com/ ; el modelo debe ser uno con soporte de imágenes
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=your-gemini-model-id

# Notificaciones push (VAPID). Generar con: npx web-push generate-vapid-keys
# La clave privada es solo de servidor. VAPID_SUBJECT debe ser un mailto: o URL https real
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com

# Seguimiento automático: el programador externo llama a /api/cron/track con "Authorization: Bearer <CRON_SECRET>"
# Generar un valor largo y aleatorio. Solo servidor
CRON_SECRET=your-long-random-secret
